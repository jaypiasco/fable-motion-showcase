# =====================================================================
# Google Gemini Multi-Account API Keys Pool
# Paste your Gemini API key(s) here (comma-separated if multiple keys).
# The system will automatically cycle through them whenever quota is hit.
# =====================================================================
GEMINI_API_KEYS=your_gemini_api_key_1, your_gemini_api_key_2

# Model & Provider Preferences
AI_STORY_SCRIPT_MODEL=gemini-3.5-flash-lite
AI_STORY_IMAGE_MODEL=google/gemini-3-pro-image
AI_STORY_TTS_PROVIDER=none
AI_STORY_WHISPER_MODEL_SIZE=base

# Cloud Persistence & Multi-Tenancy (Supabase PostgreSQL & Auth)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_publishable_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Cloud Storage (GCS) for Permanent Media & Video Hosting
# GCS_BUCKET_NAME=fable-motion-media
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/fable-motion-media

# Langfuse Observability & Tracing (e.g. Japan Cloud or EU Cloud)
# AI_STORY_ENABLE_LANGFUSE=true
# AI_STORY_LANGFUSE_PUBLIC_KEY=pk-lf-...
# AI_STORY_LANGFUSE_SECRET_KEY=sk-lf-...
# AI_STORY_LANGFUSE_HOST=https://jp.cloud.langfuse.com
